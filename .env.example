# Canonical production origin. This is also the default when unset.
NEXT_PUBLIC_SITE_URL=https://benchgrid.dev
# Production builds are indexable; local development and Vercel previews are not.
# Set false on any other staging host, then rebuild.
SITE_INDEXING=true
# Optional Search Console HTML verification token (not a service account key).
# GOOGLE_SITE_VERIFICATION=
